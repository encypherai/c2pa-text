{
  "name": "c2pa-text",
  "version": "2.1.0",
  "description": "Reference implementation for embedding C2PA manifests in text using Unicode variation selectors",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "src/**/*.ts",
    "!src/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "jest",
    "prepublishOnly": "npm run build && node -e \"require('./dist/index.js')\""
  },
  "keywords": [
    "c2pa",
    "text",
    "steganography",
    "unicode",
    "provenance",
    "content-authenticity",
    "watermark"
  ],
  "author": "Encypher Corporation <contact@encypher.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/encypherai/c2pa-text.git",
    "directory": "typescript"
  },
  "homepage": "https://encypher.com",
  "bugs": {
    "url": "https://github.com/encypherai/c2pa-text/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
